{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Windows installed-system audit report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "startedAtUtc",
    "completedAtUtc",
    "context",
    "configuration",
    "areas",
    "checks",
    "summary",
    "exitCode"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "startedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "completedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "powerShellVersion",
        "isAdministrator",
        "userSid",
        "gitCommit"
      ],
      "properties": {
        "mode": {
          "enum": [
            "Live",
            "Fixture"
          ]
        },
        "powerShellVersion": {
          "type": "string"
        },
        "isAdministrator": {
          "type": "boolean"
        },
        "userSid": {
          "type": "string"
        },
        "gitCommit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "desired"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "desired": {
          "type": "object",
          "required": [
            "SchemaVersion",
            "Edition",
            "Architecture",
            "Localization",
            "OptionalFeatures",
            "Capabilities",
            "InboxApps",
            "Policies"
          ],
          "additionalProperties": false,
          "properties": {
            "SchemaVersion": {
              "const": 1
            },
            "Edition": {
              "enum": [
                "Pro",
                "Enterprise"
              ]
            },
            "Architecture": {
              "const": "x64"
            },
            "Localization": {
              "type": "object",
              "required": [
                "UiLanguage",
                "InputLocales"
              ],
              "additionalProperties": false,
              "properties": {
                "UiLanguage": {
                  "type": "string",
                  "minLength": 1
                },
                "InputLocales": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "OptionalFeatures": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "Enabled",
                  "Disabled"
                ]
              }
            },
            "Capabilities": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "Present",
                  "Absent"
                ]
              }
            },
            "InboxApps": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "Present",
                  "Absent"
                ]
              }
            },
            "Deployment": {
              "type": "object"
            },
            "Policies": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "areas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Os",
        "OptionalFeatures",
        "Capabilities",
        "ProvisionedApps",
        "RegisteredApps",
        "Services",
        "Policies",
        "Servicing",
        "Reboot"
      ],
      "properties": {
        "Os": {
          "$ref": "#/definitions/area"
        },
        "OptionalFeatures": {
          "$ref": "#/definitions/area"
        },
        "Capabilities": {
          "$ref": "#/definitions/area"
        },
        "ProvisionedApps": {
          "$ref": "#/definitions/area"
        },
        "RegisteredApps": {
          "$ref": "#/definitions/area"
        },
        "Services": {
          "$ref": "#/definitions/area"
        },
        "Policies": {
          "$ref": "#/definitions/area"
        },
        "Servicing": {
          "$ref": "#/definitions/area"
        },
        "Deployment": {
          "$ref": "#/definitions/area"
        },
        "Reboot": {
          "$ref": "#/definitions/area"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/check"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compliant",
        "nonCompliant",
        "notVerified",
        "notApplicable",
        "incompleteAreas"
      ],
      "properties": {
        "compliant": {
          "type": "integer",
          "minimum": 0
        },
        "nonCompliant": {
          "type": "integer",
          "minimum": 0
        },
        "notVerified": {
          "type": "integer",
          "minimum": 0
        },
        "notApplicable": {
          "type": "integer",
          "minimum": 0
        },
        "incompleteAreas": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "exitCode": {
      "enum": [
        0,
        1,
        2,
        3
      ]
    }
  },
  "definitions": {
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope",
        "data",
        "errors"
      ],
      "properties": {
        "status": {
          "enum": [
            "Complete",
            "Partial",
            "Failed",
            "NotApplicable"
          ]
        },
        "scope": {
          "type": "string"
        },
        "data": {
          "type": [
            "object",
            "array"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area",
        "id",
        "expected",
        "actual",
        "status",
        "reason"
      ],
      "properties": {
        "area": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "expected": {},
        "actual": {},
        "status": {
          "enum": [
            "Compliant",
            "NonCompliant",
            "NotVerified",
            "NotApplicable"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
